# Public URL used for canonical links, the sitemap and the MCP endpoint shown in the panel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: add the public repository URL after publishing on GitHub.
# Leave empty to show "GitHub release coming soon" on the landing page.
NEXT_PUBLIC_GITHUB_URL=

# Auth: copy this file to .env.local. Development generates a local secret if omitted.
# Production requires a random secret of at least 32 characters and the real app URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# PostgreSQL is required on Vercel. Leave empty to use SQLite locally.
DATABASE_URL=
# Local SQLite file for development and a single Node host with a persistent disk.
AUTH_DATABASE_PATH=.data/auth.sqlite
AUTH_DEMO_ENABLED=true
# Used only by `pnpm auth:setup` when there is no superadmin yet.
# Set a unique password; remove it after the first successful bootstrap.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Workspace Owner

# Content integrations (not yet connected):
# UPLOADTHING_TOKEN=
# PLUNK_SECRET_KEY=
# PLUNK_FROM_EMAIL=
# OPENROUTER_API_KEY=
