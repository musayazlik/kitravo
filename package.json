{
  "name": "kitravo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm auth:setup && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "auth:setup": "node --env-file-if-exists=.env.local --import tsx scripts/auth-setup.mts",
    "test:access": "node --import tsx --test tests/access.test.mts",
    "test:routes": "node --import tsx --test tests/routes.test.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:access && pnpm test:routes",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:postgres": "node --env-file-if-exists=.env.local --import tsx scripts/test-postgres.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
